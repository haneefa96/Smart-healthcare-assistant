# ============================================================
# .env — AI Gateway Environment Variables
# Copy this file to backend/.env and fill in your credentials.
# NEVER commit this file to version control.
# ============================================================

# ── LLM Configuration ─────────────────────────────────────────────────────────
# For OpenAI GPT-4o-mini (recommended):
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ── Alternative: Use a local Ollama server (free, runs offline) ────────────────
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1

# ── Alternative: Google Gemini via OpenAI-compatible endpoint ──────────────────
# OPENAI_API_KEY=YOUR_GEMINI_API_KEY
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
