# ── RAG Configuration (local embeddings + ChromaDB vector store) ───────────────
# RAG embedding model (must be compatible with sentence-transformers)
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path to ChromaDB vector store (created automatically on first index)
RAG_VECTOR_STORE_PATH=./rag_data/vectorstore

# Document chunking parameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0.3

# Directory containing source PDF/text documents (for ingestion)
RAG_KNOWLEDGE_DIR=./rag_data/knowledge
=======
