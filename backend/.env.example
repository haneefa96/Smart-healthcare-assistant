# ============================================================
# .env — Smart Healthcare Assistant Robot Environment Variables
# Copy this file to backend/.env and fill in your credentials.
# NEVER commit backend/.env to version control.
# ============================================================

# ── Conversational AI: Google Gemini (Recommended) ───────────────────────────
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Alternative: OpenAI API ───────────────────────────────────────────────────
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ── Alternative: Local Ollama Endpoint (Offline / Free) ───────────────────────
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1

# ── Multilingual Speech-to-Text: faster-whisper ──────────────────────────────
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Text-to-Speech: Edge-TTS (Baymax-Inspired English Settings) ────────────────
TTS_DEFAULT_VOICE=en-US-AndrewMultilingualNeural
TTS_DEFAULT_RATE=-12%
TTS_DEFAULT_PITCH=-5Hz
